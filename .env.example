# Telegram Group Management Bot - Configuration Template
# Copy this file to .env and fill in your actual values

## Environment
NODE_ENV=production
LOG_LEVEL=info
LOG_FILE_PATH=./logs/bot.log

## Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

## Telegram Bot Configuration
# Get your bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here
# Bot username without @ - IMPORTANT: Must match the actual bot username from @BotFather
# You can verify it with: curl "https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getMe"
BOT_USERNAME=your_bot_username
# Your domain for webhook (include https://)
BOT_WEBHOOK_DOMAIN=https://your-domain.com
# 允许哪些上游代理提供 X-Forwarded-For（webhook 的 Telegram IP 白名单依赖它）。
# 默认 loopback,uniquelocal 适配自带的 Docker + nginx 部署：容器看到的来源是
# Docker 网桥地址 172.x.x.1。若设为 false，所有 webhook 会被当成来自网桥而被拒，
# 机器人将收不到任何消息。不支持填写跳数（数字）。仅在无任何代理直接暴露时设为 false。
TRUST_PROXY=loopback,uniquelocal
# Generate a random webhook secret for security
BOT_WEBHOOK_SECRET=generate_random_secret_here
# Mini App short name (set via @BotFather /newapp).
# Required for Chatwoot Telegram inbox verification — verification is Mini App only, no web fallback.
# BOT_MINIAPP_SHORT_NAME=app

## Chatwoot Telegram Inbox Verification Gate (Optional)
# Mini App only — there is no web fallback. BOT_USERNAME and BOT_MINIAPP_SHORT_NAME above must be set,
# otherwise the gateway endpoint returns 503.
#
# Deployment shape:
#   Telegram -> https://your-bot-domain.com/chatwoot/telegram-webhook
#            -> this service checks verification, blocks or forwards
#            -> Chatwoot native /webhooks/telegram/:bot_token endpoint
# No Chatwoot source changes required.
CHATWOOT_VERIFICATION_TTL_MINUTES=10
CHATWOOT_VERIFIED_TTL_DAYS=30
CHATWOOT_PROMPT_COOLDOWN_SECONDS=300
# CHATWOOT_GATEWAY_BASE_URL=https://your-chatwoot-domain.com
# CHATWOOT_GATEWAY_TELEGRAM_BOT_TOKEN=your_chatwoot_inbox_bot_token
# CHATWOOT_GATEWAY_WEBHOOK_SECRET=generate_random_telegram_webhook_secret_here
# CHATWOOT_GATEWAY_INBOX_ID=chatwoot-main-inbox
CHATWOOT_GATEWAY_FORWARD_TIMEOUT_SECONDS=5

## Database Configuration (PostgreSQL)
# For Docker deployment, use service name; for local, use localhost
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=telegram_bot
DB_PASSWORD=your_strong_db_password
DB_DATABASE=telegram_bot

## Redis Configuration
# For Docker deployment, use service name; for local, use localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

## Security Configuration
# Generate secure random strings using: openssl rand -hex 32
JWT_SECRET=generate_random_jwt_secret_here
# Optional: if not set, JWT_SECRET is used to derive HMAC secret
HMAC_SECRET=generate_random_hmac_secret_here

## Cloudflare Turnstile Configuration
# Get from Cloudflare dashboard: https://dash.cloudflare.com/
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

## hCaptcha Configuration (Optional Desktop Fallback)
# Get from hCaptcha dashboard: https://dashboard.hcaptcha.com/
# HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
# HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key

## Bot Default Settings
DEFAULT_VERIFY_TTL_MINUTES=10
DEFAULT_AUTO_ACTION=mute
# 0 = 踢出后立即允许重新入群；正数 = 冷却秒数（会自动提高到至少 35 秒）
VERIFICATION_REJOIN_COOLDOWN_SECONDS=60

# 入群时查询 CAS 反垃圾黑名单（https://cas.chat），已知广告账号直接封禁、
# 不再给它解验证码的机会。会把入群成员的 Telegram 数字 ID 发送到 api.cas.chat；
# 查询失败时按“未收录”处理，不会阻止任何人入群。设为 false 关闭。
CAS_ENABLED=true
DEFAULT_RATE_LIMIT_WINDOW_MS=60000
DEFAULT_RATE_LIMIT_MAX_REQUESTS=10

## Optional: Proxy Configuration (if needed)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# IMPORTANT NOTES:
# 1. Never commit .env file to version control
# 2. Use strong passwords for database and Redis
# 3. Generate cryptographically secure random strings for secrets
# 4. Ensure your webhook domain has valid SSL certificate
# 5. For production, always use HTTPS for webhook domain
